# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in your Supabase project: Settings -> API.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose this to the browser or commit it. Used by
# route handlers (matching engine, guest flow, demo seed) to bypass RLS
# for cross-user computation. Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Shared password used for the one-tap demo login buttons (Haru/Yuki/Mei/Ren/Sora/Takumi).
# Public on purpose (the demo buttons need it client-side) — change it, or
# remove the demo users, before deploying anywhere semi-public.
NEXT_PUBLIC_DEMO_USER_PASSWORD=tonight-demo-pass

# Used to build absolute invite URLs (e.g. https://tonight.vercel.app).
# Falls back to http://localhost:3000 in development if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — used by /api/cron/reminders (the day-of email reminder for
# advance-registered dates) to send mail via Resend (resend.com). Sign up,
# create an API key under Resend -> API Keys, and paste it here.
RESEND_API_KEY=your-resend-api-key

# Server-only — shared secret that /api/cron/reminders checks in the
# x-cron-secret header, so only your scheduler (see
# .github/workflows/daily-reminders.yml) can trigger it. Make up any random
# string; it must match the CRON_SECRET GitHub Actions secret exactly.
CRON_SECRET=change-me-to-a-random-string

# Server-only — TURN server for in-browser voice calls (WebRTC). Optional:
# calls work with public STUN alone on the same network / for demos, but a
# TURN relay is needed for peers behind symmetric NAT or strict mobile
# networks. Leave unset to run STUN-only. Served to the client via /api/turn
# so the credential never ships in the bundle.
#   TURN_URLS       comma-separated turn:/turns: URLs
#   TURN_USERNAME   TURN username
#   TURN_CREDENTIAL TURN credential
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Public — link target for "写真を動画にする" nav entry. That feature stays
# an independently-deployed app (see src/lib/external-links.ts) rather than
# being merged into this repo. Falls back to the current deployment if unset.
NEXT_PUBLIC_VIDEO_STUDIO_URL=https://tornado2026-tearm-h.vercel.app/
